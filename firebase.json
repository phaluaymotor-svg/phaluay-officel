{
  "functions": {"source":"functions"},
  "firestore": {"rules":"firestore.rules"},
  "hosting": {
    "public":".",
    "ignore":["firebase.json","**/.*","**/node_modules/**","functions/**","scripts/**","SETUP_FIREBASE.md","SOURCES.md","README.md"],
